PUERTO=3100
URL_FRONTEND=http://localhost:4300
DB_SERVIDOR=
DB_PUERTO=1433
DB_NOMBRE=
DB_USUARIO=
DB_CONTRASENA=
DB_CONFIAR_CERTIFICADO=false

NODE_ENV=development
# Solo desarrollo: se usa cuando la petición NO trae token (pruebas con curl o scripts)
CORREO_PRUEBA=

# Solo desarrollo: Integra responde datos de ejemplo (ver src/services/integra.service.js)
INTEGRA_SIMULADO=false

# Login con Microsoft (Entra ID). Mismo registro de aplicación que el Portal.
# No son secretos: sirven para validar que el token es de nuestra empresa y app.
AZURE_TENANT_ID=
AZURE_CLIENT_ID=

# Adjuntos (imágenes de los pases) en Azure Blob Storage.
# Por ahora se usa la misma cuenta y contenedor del Portal, en la carpeta pases_salida/.
# AZURE_STORAGE_ENV separa los ambientes: local, dev, qa, prod.
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=multimedia
AZURE_STORAGE_ENV=local
